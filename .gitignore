*.pyc
*.pyo
*.pyd
*.pyd
*.pkl
*.db

# venv
.venv/
env/
venv/

# Pydantic cache
.pytest_cache/
.pyre/

# ===========================================
# EDITOR / IDE
# ===========================================
.vscode/
.idea/
*.swp
*.swo

# ===========================================
# DEVCONTAINER
# ===========================================
.devcontainer/.env
.devcontainer/cache/
.devcontainer/Dockerfile.*
.devcontainer/docker-compose.override.yml

