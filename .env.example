# ============================================================================
# MEDBOX Backend Environment Configuration
# ============================================================================
# Copy this file to .env and update the values for your environment
# ============================================================================

# ============================================================================
# Database Configuration
# ============================================================================
# PostgreSQL connection details
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=medbox_user
DATABASE_PASSWORD=changeme_db_password
DATABASE_NAME=medbox_db

# ============================================================================
# Redis Configuration
# ============================================================================
# Redis connection for task queue and caching
# Format: redis://[host]:[port]/[db]
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# Keycloak / Authentication
# ============================================================================
# Keycloak server URL 
KEYCLOAK_URL=http://localhost:8080

# Keycloak realm name
KEYCLOAK_REALM=medbox

# Keycloak client credentials
KEYCLOAK_CLIENT_ID=medbox-backend
KEYCLOAK_CLIENT_SECRET=changeme_client_secret

# ============================================================================
# AWS S3 / Object Storage
# ============================================================================
# S3 endpoint (e.g., https://s3.amazonaws.com or minio endpoint)
S3_ENDPOINT=https://s3.amazonaws.com

# AWS region
S3_REGION=eu-west-1

# S3 bucket name for documents/files
S3_BUCKET=medbox-documents

# AWS access key
S3_ACCESS_KEY=changeme_aws_access_key

# AWS secret key
S3_SECRET_KEY=changeme_aws_secret_key

# ============================================================================
# EMQX / MQTT
# ============================================================================
EMQX_HOST=emqx.internal
EMQX_PORT=8883
EMQX_CA_CERT=/app/certs/ca.crt
EMQX_CLIENT_CERT=/app/certs/worker.crt
EMQX_CLIENT_KEY=/app/certs/worker.key

# ============================================================================
# Security
# ============================================================================
# Encryption key for sensitive fields (must be 32 bytes)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
ENCRYPTION_KEY=3c319cc98216790e21079df5995707f3

# ============================================================================
# Application Settings
# ============================================================================
# Application base URL (used for links, redirects, etc.)
APP_URL=http://localhost:8000

# API URL prefix
URL_PREFIX=/api

# Environment mode (development, staging, production)
ENVIRONMENT=development

# ============================================================================
# Box monitoring
# ============================================================================
# Seuil (en minutes) au-dela duquel une box sans telemetry est consideree
# offline. Utilise par get_stats() et par la tache Celery monitor_boxes.
BOX_OFFLINE_THRESHOLD_MINUTES=10

